{
  "name": "living-code-sublime",
  "version": "0.1.1",
  "description": "Living Code for Sublime Text. Repository-owned theme files, installation instructions and four color flavors.",
  "type": "module",
  "license": "MIT",
  "author": "Living Code",
  "repository": {
    "type": "git",
    "url": "https://github.com/living-code-theme/sublime.git"
  },
  "homepage": "https://github.com/living-code-theme/sublime",
  "private": true,
  "packageManager": "pnpm@12.9.0",
  "engines": {
    "node": ">=22.22"
  },
  "livingCode": {
    "kind": "sublime"
  },
  "devDependencies": { "shiki": "4.5.0" },
  "scripts": {
    "check": "node scripts/check.mjs",
    "test": "node scripts/check.mjs && node --test test/*.test.mjs",
    "build": "node scripts/generate.mjs",
    "check:generated": "node scripts/generate.mjs --check",
    "palette:update": "node scripts/update-palette.mjs",
    "package": "node scripts/package.mjs",
    "package:sublime": "node scripts/package.mjs"
  }
}
